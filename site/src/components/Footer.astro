// Footer override for the Starlight docs pages. Starlight's `components.Footer`
// slot swaps this in for the built-in footer on every docs page; we render the
// default footer unchanged (edit link, last-updated, pagination) and append an
// author credit so the credit that lives in the homepage's own footer also
// reaches every docs page — the standalone homepage route never renders this
// component, so the two footers must each carry the credit independently.
//
// The default is imported from its concrete path in the Starlight package
// rather than the `virtual:starlight/components/Footer` module: once this file
// is registered as the Footer override, that virtual module resolves to THIS
// component, so importing it here would recurse infinitely. The concrete path
// is stable within a Starlight major; a future upgrade that relocates it will
// fail the build loudly (caught by the site build gate), not silently.
import Default from "@astrojs/starlight/components/Footer.astro";

// Match the homepage footer's external-anchor treatment (muted foreground with
// a loud-border underline) via the shared --sl-* token layer so the link colour
// resolves in both light and dark themes, and carry rel="noopener" for the
// external link (consistent with the homepage footer's external anchors).
---

<Default {...Astro.props} />

<p class="okfctl-author-credit">
  Made by <a href="https://caseywest.com/" rel="noopener">Casey West</a>.
</p>

<style>
  @layer starlight.core {
    .okfctl-author-credit {
      margin: 0 0 1.5rem;
      font-size: var(--sl-text-sm);
      color: var(--sl-color-gray-3);
    }
    .okfctl-author-credit a {
      color: var(--sl-color-gray-3);
      border-bottom: 1px solid var(--sl-color-gray-5);
    }
    .okfctl-author-credit a:hover {
      color: var(--sl-color-white);
    }
  }
</style>
