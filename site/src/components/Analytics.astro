// The Google Analytics 4 tag for the standalone homepage (src/pages/index.astro),
// which Starlight never renders and so cannot reach via the `head` array in
// astro.config.mjs. Both paths draw the tag — and the production gate — from the
// single source of truth in src/lib/analytics.ts, so the homepage and the docs
// pages can never drift apart. Emits nothing outside a production build with a
// configured PUBLIC_GA_MEASUREMENT_ID.
import { analyticsHeadTags } from "../lib/analytics.ts";

const tags = analyticsHeadTags();
---

{
  tags.map((t) =>
    t.attrs?.src ? (
      // The gtag.js loader.
      <script async={t.attrs.async} src={t.attrs.src}></script>
    ) : (
      // The inline gtag() config. `set:html` ships the body as RAW JavaScript;
      // wrapping raw JS in a JSX expression would escape it.
      <script set:html={t.content}></script>
    ),
  )
}
