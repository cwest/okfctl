    <div class="sr" role="status" aria-live="polite" id="live"></div>

    <script is:inline>
      (() => {
        const $ = (s, r = document) => r.querySelector(s);
        const $$ = (s, r = document) => [...r.querySelectorAll(s)];
        const live = $("#live");
        const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

        /* ── theme (shares Starlight's `starlight-theme` key) ──────────────── */
        const root = document.documentElement,
          tbtn = $("#theme"),
          ticon = $("#theme-icon");
        const MOON = "M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z";
        const SUN =
          "M12 4V2M12 22v-2M4 12H2M22 12h-2M6.3 6.3 4.9 4.9M19.1 19.1l-1.4-1.4M6.3 17.7l-1.4 1.4M19.1 4.9l-1.4 1.4M16 12a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z";
        const paint = (t) => {
          root.dataset.theme = t;
          ticon.innerHTML = `<path d="${t === "dark" ? MOON : SUN}"/>`;
          tbtn.setAttribute("aria-label", `Switch to ${t === "dark" ? "light" : "dark"} theme`);
        };
        paint(root.dataset.theme || "dark");
        tbtn.addEventListener("click", () => {
          const t = root.dataset.theme === "dark" ? "light" : "dark";
          localStorage.setItem("starlight-theme", t);
          paint(t);
        });

        /* ── header hairline on scroll ─────────────────────────────────────── */
        const hdr = $("#hdr");
        const onScroll = () => (hdr.dataset.scrolled = String(scrollY > 8));
        addEventListener("scroll", onScroll, { passive: true });
        onScroll();

        /* ── small-screen nav sheet ────────────────────────────────────────── */
        const sheet = $("#sheet"),
          navToggle = $("#navtoggle");
        const setSheet = (open) => {
          sheet.dataset.open = String(open);
          navToggle.setAttribute("aria-expanded", String(open));
          navToggle.setAttribute("aria-label", open ? "Close navigation" : "Open navigation");
        };
        navToggle.addEventListener("click", () => setSheet(sheet.dataset.open !== "true"));
        $$("#sheet a").forEach((a) => a.addEventListener("click", () => setSheet(false)));
        addEventListener("keydown", (e) => {
          if (e.key === "Escape" && sheet.dataset.open === "true") {
            setSheet(false);
            navToggle.focus();
          }
        });
        matchMedia("(min-width:901px)").addEventListener("change", (e) => {
          if (e.matches) setSheet(false);
        });

        /* ── copy ──────────────────────────────────────────────────────────── */
        const copyText = async (text, btn) => {
          try {
            await navigator.clipboard.writeText(text);
          } catch {
            const ta = Object.assign(document.createElement("textarea"), { value: text });
            ta.style.cssText = "position:fixed;opacity:0";
            document.body.append(ta);
            ta.select();
            document.execCommand("copy");
            ta.remove();
          }
          const label = $(".label", btn),
            was = label.textContent;
          label.textContent = "Copied";
          btn.dataset.copied = "true";
          live.textContent = "Copied to clipboard";
          setTimeout(() => {
            label.textContent = was;
            btn.dataset.copied = "false";
          }, 1600);
        };
        $$("[data-copy]").forEach((b) => b.addEventListener("click", () => copyText(b.dataset.copy, b)));

        /* ── terminal tabs ─────────────────────────────────────────────────── */
        const tabs = $$(".term-tab");
        const chip = $("#exit-chip"),
          note = $("#exit-note");
        const META = {
          "tab-cold": [0, "clean cold start"],
          "tab-val": [1, "spec-floor violation — always fatal"],
          "tab-lint": [1, "advisory run exits 0; --strict exits 1"],
          "tab-eval": [1, "provenance gate — advisory exits 0; --strict exits 1"],
          "tab-scale": [0, "a real corpus, not a fixture"],
        };
        const select = (id) => {
          tabs.forEach((t) => {
            const on = t.id === id;
            t.setAttribute("aria-selected", String(on));
            t.tabIndex = on ? 0 : -1;
            $("#" + t.getAttribute("aria-controls")).hidden = !on;
          });
          const [code, text] = META[id];
          chip.textContent = "exit " + code;
          chip.className = "exit exit--" + code;
          note.textContent = text;
        };
        tabs.forEach((t) => t.addEventListener("click", () => select(t.id)));
        $(".term-tabs").addEventListener("keydown", (e) => {
          const i = tabs.findIndex((t) => t.getAttribute("aria-selected") === "true");
          const d = e.key === "ArrowRight" ? 1 : e.key === "ArrowLeft" ? -1 : 0;
          if (!d) return;
          e.preventDefault();
          const next = tabs[(i + d + tabs.length) % tabs.length];
          select(next.id);
          next.focus();
        });
        $("#copy-run").addEventListener("click", function () {
          const panel = $$('[role="tabpanel"]').find((p) => !p.hidden);
          const cmds = [...panel.querySelectorAll("pre")][0].textContent
            .split("\n")
            .filter((l) => l.startsWith("$ "))
            .map((l) => l.slice(2))
            .join("\n");
          copyText(cmds, this);
        });

        /* ── link-graph move ───────────────────────────────────────────────── */
        const svg = $("#gsvg"),
          tannin = $("#node-tannin"),
          edges = $$("#edges .edge");
        const btn = $("#mv-btn"),
          out = $("#mv-out"),
          zone = $("#zone-ref");
        const stateFlag = $("#graph-state"),
          diffFlag = $("#diff-state");
        const HOME = { x: 0, y: 0 },
          AWAY = { x: 300, y: -46 };
        const SRC = [
          { y: 86, lane: 232 },
          { y: 140, lane: 250 },
          { y: 194, lane: 268 },
          { y: 344, lane: 286 },
        ];
        const FACE = 184;
        let moved = false,
          raf = 0;

        const draw = (p) => {
          const dx = HOME.x + (AWAY.x - HOME.x) * p,
            dy = HOME.y + (AWAY.y - HOME.y) * p;
          tannin.style.transform = `translate(${dx}px, ${dy}px)`;
          const tLeft = 44 + dx,
            tRight = tLeft + 140,
            tTop = 222 + dy;
          edges.forEach((e, i) => {
            const s = SRC[i],
              lane = s.lane;
            const enter = lane < tLeft ? tLeft : tRight;
            const bend = lane < tLeft ? lane : Math.max(lane, tRight + 22);
            const ey = tTop + 7 + i * 6;
            e.setAttribute("d", `M ${FACE} ${s.y} H ${bend} V ${ey} H ${enter}`);
            e.classList.toggle("hot", p > 0.02 && p < 0.98);
          });
          zone.style.opacity = 0.35 + 0.65 * p;
        };

        const tween = (from, to, ms) => {
          cancelAnimationFrame(raf);
          if (reduce) {
            draw(to);
            return;
          }
          const t0 = performance.now();
          const step = (now) => {
            const k = Math.min(1, (now - t0) / ms);
            const e = k < 0.5 ? 4 * k * k * k : 1 - Math.pow(-2 * k + 2, 3) / 2;
            draw(from + (to - from) * e);
            if (k < 1) raf = requestAnimationFrame(step);
          };
          raf = requestAnimationFrame(step);
        };

        const applyDiff = (after) => {
          $("#diff").dataset.state = after ? "after" : "before";
          $$('#diff .row.add[data-when="after"]').forEach((r) => (r.hidden = !after));
          $("#log-before").hidden = after;
          $("#log-after").hidden = !after;
          diffFlag.textContent = after ? "after" : "before";
          diffFlag.style.color = after ? "var(--ok)" : "var(--fg-muted)";
        };

        const setState = (next) => {
          moved = next;
          tween(next ? 0 : 1, next ? 1 : 0, 900);
          applyDiff(next);
          out.hidden = !next;
          out.textContent = next
            ? "✓ Moved concepts/tannin.md -> reference/tannin.md (4 inbound link(s) rewritten)"
            : "";
          btn.innerHTML = next ? "Reset" : 'Run <span class="mono" style="font-weight:500">node mv</span>';
          stateFlag.textContent = next
            ? "4 inbound links → reference/tannin.md"
            : "4 inbound links → concepts/tannin.md";
          if (next)
            live.textContent =
              "Moved concepts/tannin.md to reference/tannin.md, 4 inbound links rewritten";
        };

        draw(0);
        applyDiff(false);
        btn.addEventListener("click", () => setState(!moved));
      })();
    </script>
  </body>
</html>
