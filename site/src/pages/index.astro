    <script is:inline>
      (() => {
        const $ = (s, r = document) => r.querySelector(s);
        const $$ = (s, r = document) => [...r.querySelectorAll(s)];
        const live = $("#live");
        const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

        /* ── theme: tri-state (system / light / dark) sharing Starlight's
              `starlight-theme` key ────────────────────────────────────────────
           A runtime copy of the pure logic in src/lib/theme.ts (unit-tested);
           it MUST stay in lockstep with that module. Starlight encodes "follow
           the system" as the EMPTY STRING and writes only 'light'/'dark'
           literally, so '', null, and any unknown value all mean "system" —
           never a literal 'system' in the shared key. `data-theme` is the
           EFFECTIVE theme the CSS keys off (shared with Starlight);
           `data-theme-choice` is the tri-state CHOICE the icon + label key off. */
        const root = document.documentElement,
          tbtn = $("#theme");
        const THEME_CHOICES = ["system", "light", "dark"];
        const normalizeChoice = (raw) =>
          raw === "light" || raw === "dark" ? raw : "system";
        const nextChoice = (cur) =>
          THEME_CHOICES[(THEME_CHOICES.indexOf(normalizeChoice(cur)) + 1) % THEME_CHOICES.length];
        const systemPrefersDark = () => matchMedia("(prefers-color-scheme: dark)").matches;
        const resolveEffective = (choice) => {
          const n = normalizeChoice(choice);
          return n === "system" ? (systemPrefersDark() ? "dark" : "light") : n;
        };
        const ariaLabelFor = (choice) => {
          const c = normalizeChoice(choice);
          return `Theme: ${c} (tap for ${nextChoice(c)})`;
        };
        const choiceToStorage = (choice) => {
          const n = normalizeChoice(choice);
          return n === "system" ? "" : n;
        };
        // Reflect a choice into the DOM: effective theme, icon selector, label.
        const reflectChoice = (choice) => {
          const c = normalizeChoice(choice);
          root.dataset.theme = resolveEffective(c);
          root.dataset.themeChoice = c;
          tbtn.setAttribute("aria-label", ariaLabelFor(c));
        };
        reflectChoice(localStorage.getItem("starlight-theme"));
        tbtn.addEventListener("click", () => {
          const advanced = nextChoice(localStorage.getItem("starlight-theme"));
          localStorage.setItem("starlight-theme", choiceToStorage(advanced));
          reflectChoice(advanced);
        });
        // Live OS listener: while in 'system' mode, re-resolve when the OS flips
        // light<->dark mid-session. An explicit light/dark choice is unaffected
        // because resolveEffective ignores the OS for those.
        matchMedia("(prefers-color-scheme: dark)").addEventListener("change", () => {
          if (normalizeChoice(localStorage.getItem("starlight-theme")) === "system") {
            reflectChoice("system");
          }
        });

        /* ── header hairline on scroll ─────────────────────────────────────── */
        const hdr = $("#hdr");
        const onScroll = () => (hdr.dataset.scrolled = String(scrollY > 8));
        addEventListener("scroll", onScroll, { passive: true });
        onScroll();

        /* ── small-screen nav sheet ────────────────────────────────────────── */
        const sheet = $("#sheet"),
          navToggle = $("#navtoggle");
        const setSheet = (open) => {
          sheet.dataset.open = String(open);
          navToggle.setAttribute("aria-expanded", String(open));
          navToggle.setAttribute("aria-label", open ? "Close navigation" : "Open navigation");
        };
        navToggle.addEventListener("click", () => setSheet(sheet.dataset.open !== "true"));
        $$("#sheet a").forEach((a) => a.addEventListener("click", () => setSheet(false)));
        addEventListener("keydown", (e) => {
          if (e.key === "Escape" && sheet.dataset.open === "true") {
            setSheet(false);
            navToggle.focus();
          }
        });
        matchMedia("(min-width:901px)").addEventListener("change", (e) => {
          if (e.matches) setSheet(false);
        });

        /* ── copy ──────────────────────────────────────────────────────────── */
        const copyText = async (text, btn) => {
          try {
            await navigator.clipboard.writeText(text);
          } catch {
            const ta = Object.assign(document.createElement("textarea"), { value: text });
            ta.style.cssText = "position:fixed;opacity:0";
            document.body.append(ta);
            ta.select();
            document.execCommand("copy");
            ta.remove();
          }
          const label = $(".label", btn),
            was = label.textContent;
          label.textContent = "Copied";
          btn.dataset.copied = "true";
          live.textContent = "Copied to clipboard";
          setTimeout(() => {
            label.textContent = was;
            btn.dataset.copied = "false";
          }, 1600);
        };
        $$("[data-copy]").forEach((b) => b.addEventListener("click", () => copyText(b.dataset.copy, b)));

        /* ── terminal tabs ─────────────────────────────────────────────────── */
        const tabs = $$(".term-tab");
        const chip = $("#exit-chip"),
          note = $("#exit-note");
        const META = {
          "tab-cold": [0, "a fresh bundle that passes validate"],
          "tab-lint": [1, "lint exits 0; --strict exits 1"],
          "tab-eval": [1, "--strict turns the findings into a failure"],
          "tab-val": [1, "a spec violation fails validate"],
          "tab-scale": [0, "a bundle someone else wrote"],
        };
        const select = (id) => {
          tabs.forEach((t) => {
            const on = t.id === id;
            t.setAttribute("aria-selected", String(on));
            t.tabIndex = on ? 0 : -1;
            $("#" + t.getAttribute("aria-controls")).hidden = !on;
          });
          const [code, text] = META[id];
          chip.textContent = "exit " + code;
          chip.className = "exit exit--" + code;
          note.textContent = text;
        };
        tabs.forEach((t) => t.addEventListener("click", () => select(t.id)));
        $(".term-tabs").addEventListener("keydown", (e) => {
          const i = tabs.findIndex((t) => t.getAttribute("aria-selected") === "true");
          const d = e.key === "ArrowRight" ? 1 : e.key === "ArrowLeft" ? -1 : 0;
          if (!d) return;
          e.preventDefault();
          const next = tabs[(i + d + tabs.length) % tabs.length];
          select(next.id);
          next.focus();
        });
        $("#copy-run").addEventListener("click", function () {
          const panel = $$('[role="tabpanel"]').find((p) => !p.hidden);
          const cmds = [...panel.querySelectorAll("pre")][0].textContent
            .split("\n")
            .filter((l) => l.startsWith("$ "))
            .map((l) => l.slice(2))
            .join("\n");
          copyText(cmds, this);
        });

        /* ── link-graph move ───────────────────────────────────────────────── */
        const svg = $("#gsvg"),
          tannin = $("#node-tannin"),
          edges = $$("#edges .edge");
        const btn = $("#mv-btn"),
          out = $("#mv-out"),
          zone = $("#zone-ref");
        const stateFlag = $("#graph-state"),
          diffFlag = $("#diff-state");
        const HOME = { x: 0, y: 0 },
          AWAY = { x: 300, y: -46 };
        const SRC = [
          { y: 86, lane: 232 },
          { y: 140, lane: 250 },
          { y: 194, lane: 268 },
          { y: 344, lane: 286 },
        ];
        const FACE = 184;
        let moved = false,
          raf = 0;

        const draw = (p) => {
          const dx = HOME.x + (AWAY.x - HOME.x) * p,
            dy = HOME.y + (AWAY.y - HOME.y) * p;
          tannin.style.transform = `translate(${dx}px, ${dy}px)`;
          const tLeft = 44 + dx,
            tRight = tLeft + 140,
            tTop = 222 + dy;
          edges.forEach((e, i) => {
            const s = SRC[i],
              lane = s.lane;
            const enter = lane < tLeft ? tLeft : tRight;
            const bend = lane < tLeft ? lane : Math.max(lane, tRight + 22);
            const ey = tTop + 7 + i * 6;
            e.setAttribute("d", `M ${FACE} ${s.y} H ${bend} V ${ey} H ${enter}`);
            e.classList.toggle("hot", p > 0.02 && p < 0.98);
          });
          zone.style.opacity = 0.35 + 0.65 * p;
        };

        const tween = (from, to, ms) => {
          cancelAnimationFrame(raf);
          if (reduce) {
            draw(to);
            return;
          }
          const t0 = performance.now();
          const step = (now) => {
            const k = Math.min(1, (now - t0) / ms);
            const e = k < 0.5 ? 4 * k * k * k : 1 - Math.pow(-2 * k + 2, 3) / 2;
            draw(from + (to - from) * e);
            if (k < 1) raf = requestAnimationFrame(step);
          };
          raf = requestAnimationFrame(step);
        };

        const applyDiff = (after) => {
          $("#diff").dataset.state = after ? "after" : "before";
          $$('#diff .row.add[data-when="after"]').forEach((r) => (r.hidden = !after));
          $("#log-after").hidden = !after;
          diffFlag.textContent = after ? "after" : "before";
          diffFlag.style.color = after ? "var(--ok)" : "var(--fg-muted)";
        };

        const setState = (next) => {
          moved = next;
          tween(next ? 0 : 1, next ? 1 : 0, 900);
          applyDiff(next);
          out.hidden = !next;
          out.textContent = next
            ? "✓ Moved concepts/tannin.md -> reference/tannin.md (4 inbound link(s) rewritten)"
            : "";
          btn.innerHTML = next ? "Reset" : 'Run <span class="mono" style="font-weight:500">node mv</span>';
          stateFlag.textContent = next
            ? "4 inbound links → reference/tannin.md"
            : "4 inbound links → concepts/tannin.md";
          if (next)
            live.textContent =
              "Moved concepts/tannin.md to reference/tannin.md, 4 inbound links rewritten";
        };

        draw(0);
        applyDiff(false);
        btn.addEventListener("click", () => setState(!moved));
      })();
    </script>
  </body>
</html>
