// The bespoke okfctl.dev landing page. This is a STANDALONE Astro page (it owns
// the `/` route), not a Starlight splash — the design carries its own header,
// footer, and theme toggle. It shares the design-token layer with the Starlight
// docs pages via src/styles/tokens.css, and it aligns its theme toggle to
// Starlight's `starlight-theme` localStorage key + `data-theme` attribute so a
// visitor's light/dark choice persists across the homepage and the docs.
//
// How the facts on this page stay true:
//   - The version chip and footer version read version.ts (GitHub releases API
//     at build time). No version string is typed anywhere on this page.
//   - Every terminal panel is a pre element with a data-transcript attribute.
//     The Go test TestHomepageTranscripts (internal/transcript) builds okfctl
//     from the tree and replays each panel's `$ ` lines in order, in one
//     working directory, so the tabs share one bundle. Each command must print
//     exactly the lines shown. A transcript comment just inside a panel
//     declares a non-zero exit or builds state the panel doesn't show; Astro
//     drops those comments from the HTML. Change what a command prints and
//     that test names the line here that drifted.
//   - The "at scale" panel replays against testdata/transcripts/homepage/, a
//     pinned copy of the Stack Overflow sample bundle from the OKF repository,
//     so its counts come from a bundle anyone can fetch.
import "../styles/tokens.css";
import "../styles/homepage.css";
import { fetchLatestVersion } from "../lib/version.ts";
// The social card URL, versioned by og.png's content hash; the same helper
// feeds the Starlight head in astro.config.mjs.
import { versionedOgUrl } from "../../scripts/og-image.mjs";
import ogVersion from "../../.share-assets/og-version.json";
// Google Analytics 4. This standalone route is one of the site's two <head>
// render paths (the other is the Starlight `head` array in astro.config.mjs);
// both draw the tag from the same src/lib/analytics.ts, so they cannot diverge.
// Emits nothing outside a production build with PUBLIC_GA_MEASUREMENT_ID set.
import Analytics from "../components/Analytics.astro";

const version = await fetchLatestVersion();
const ogImage = versionedOgUrl(ogVersion.hash);
// The chip shows the derived tag when a release exists, or a neutral,
// version-free label otherwise. Never a hardcoded number.
const versionLabel = version.tag ?? "latest";
// The featured install is the stable one-liner (detects OS/arch, verifies the
// release checksum, installs okfctl + okfctl-search). It is a fixed URL, not a
// version-pinned claim, so nothing here rots. The version-derived `go install`
// path is shown below as a secondary option.
const installCmd = "curl -sSL https://okfctl.dev/install.sh | sh";
const goInstallCmd = version.tag
  ? `go install github.com/cwest/okfctl@${version.tag}`
  : "go install github.com/cwest/okfctl@latest";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <title>okfctl: a CLI for authoring and maintaining Open Knowledge Format bundles</title>
    <meta
      name="description"
      content="okfctl scaffolds, validates, lints and migrates Open Knowledge Format bundles. Pure Go, and it runs offline."
    />
    <link rel="canonical" href="https://okfctl.dev/" />
    {/* Icons and the social share card. The docs pages get these from the
        `head` array in astro.config.mjs, but this page is a standalone Astro
        route that Starlight never renders — so it has to carry them itself or
        the site's most-shared URL unfurls bare. Absolute URLs are required so
        the card resolves off-site. Keep in sync with astro.config.mjs. */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="180x180" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://okfctl.dev/" />
    <meta
      property="og:title"
      content="okfctl: a CLI for authoring and maintaining Open Knowledge Format bundles"
    />
    <meta
      property="og:description"
      content="okfctl scaffolds, validates, lints and migrates Open Knowledge Format bundles. Pure Go, and it runs offline."
    />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="okfctl: author and maintain Open Knowledge Format bundles."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;700&family=Newsreader:ital,opsz,wght@0,6..72,300..600;1,6..72,300..500&display=swap"
      rel="stylesheet"
    />
    {/* Set the theme before first paint, sharing Starlight's `starlight-theme`
        key so the choice persists across the homepage and the docs. This is a
        FOUC-safe copy of the pure logic in src/lib/theme.ts (unit-tested); it
        MUST stay in lockstep with that module. Starlight encodes "follow the
        system" as the EMPTY STRING, so '', null, and any unknown value all mean
        "system" — never a literal 'system' in that key. `data-theme` carries the
        EFFECTIVE theme (what the CSS keys off, shared with Starlight);
        `data-theme-choice` carries the tri-state CHOICE (what the icon + label
        key off). */}
    <script is:inline>
      (() => {
        const normalizeChoice = (raw) =>
          raw === "light" || raw === "dark" ? raw : "system";
        const choice = normalizeChoice(localStorage.getItem("starlight-theme"));
        const systemPrefersDark = matchMedia("(prefers-color-scheme: dark)").matches;
        const effective =
          choice === "system" ? (systemPrefersDark ? "dark" : "light") : choice;
        const root = document.documentElement;
        root.dataset.theme = effective;
        root.dataset.themeChoice = choice;
      })();
    </script>
    <Analytics />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <!-- ══ header ══════════════════════════════════════════════════════════ -->
    <header class="hdr" id="hdr">
      <div class="wrap hdr-in">
        <a href="#main" class="brand" aria-label="okfctl.dev home">
          <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true" fill="none">
            <path d="M4 5 L16 10 M4 5 L4 15 M4 15 L16 10" stroke="currentColor" stroke-width="1.1" opacity=".45" />
            <circle cx="4" cy="5" r="2.4" fill="var(--accent)" />
            <circle cx="4" cy="15" r="2" fill="currentColor" opacity=".55" />
            <circle cx="16" cy="10" r="2" fill="currentColor" opacity=".55" />
          </svg>
          <span class="brand-wm">okfctl<span class="dot">.</span>dev</span>
        </a>
        <nav class="nav" aria-label="Primary">
          <a href="#graph" class="sec-link">Link graph</a>
          <a href="#output" class="sec-link">Output</a>
          <a href="#why" class="sec-link">Why</a>
          <a href="/concepts/" class="sec-link">Docs</a>
          <a href="https://github.com/cwest/okfctl" rel="noopener">GitHub&nbsp;↗</a>
          <span class="vchip" title="Latest release">{versionLabel}</span>
          <button
            class="icon-btn"
            id="theme"
            type="button"
            aria-label="Theme: system (tap for light)"
          >
            {/* Three inline SVGs — one per tri-state choice. Exactly one shows,
                selected by html[data-theme-choice] (set FOUC-safe above and
                updated on each cycle in the runtime script below). */}
            <svg
              class="theme-icon theme-icon-system"
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              {/* Split-disc: circle outline with the left half filled = follow system. */}
              <circle cx="12" cy="12" r="9" />
              <path d="M12 3a9 9 0 0 0 0 18z" fill="currentColor" stroke="none" />
            </svg>
            <svg
              class="theme-icon theme-icon-light"
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              {/* Sun. */}
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
            </svg>
            <svg
              class="theme-icon theme-icon-dark"
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              {/* Moon. */}
              <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
            </svg>
          </button>
          <button
            class="icon-btn nav-toggle"
            id="navtoggle"
            type="button"
            aria-expanded="false"
            aria-controls="sheet"
            aria-label="Open navigation"
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" /></svg>
          </button>
        </nav>
      </div>
      <div class="sheet" id="sheet" data-open="false">
        <a href="#graph">Link graph <span>01</span></a>
        <a href="#output">Output <span>02</span></a>
        <a href="#why">Why this exists <span>03</span></a>
        <a href="/concepts/">Documentation <span>04</span></a>
        <a href="https://github.com/cwest/okfctl" rel="noopener">GitHub <span>{versionLabel} ↗</span></a>
      </div>
    </header>

    <main id="main">
      <!-- ══ hero ════════════════════════════════════════════════════════════ -->
      <section class="hero">
        <div class="wrap hero-grid">
          <div>
            <p class="eyebrow"><b>OKF</b> &nbsp;/&nbsp; spec-conformant authoring CLI &nbsp;/&nbsp; Apache-2.0</p>
            <h1 class="h-display">Knowledge you can <em>move</em> without breaking.</h1>
            <p class="lede">
              If your knowledge base is a folder of Markdown files that link to each other,{" "}
              <code class="mono" style="color:var(--fg)">okfctl</code> holds it to the{" "}
              <a href="https://github.com/open-knowledge-format/open-knowledge-format/blob/main/SPEC.md" rel="noopener">Open Knowledge Format</a>.
              It creates the files, rewrites every link when you rename one, and checks the whole folder in CI.
            </p>

            <div class="hero-actions">
              <div class="cmd">
                <code><span class="sigil" aria-hidden="true">$</span><span id="install-text">{installCmd}</span></code>
                <button class="copy" type="button" data-copy={installCmd} aria-label="Copy install command">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2" /><path d="M5 15V5a2 2 0 0 1 2-2h10" /></svg>
                  <span class="label">Copy</span>
                </button>
              </div>
              <a class="btn" href="/concepts/">Read the docs</a>
            </div>
            <p class="small" style="margin-top:var(--s-3)">
              With Homebrew: <code class="mono" style="color:var(--fg-muted)">brew install cwest/tap/okfctl</code>.
              With a Go toolchain: <code class="mono" style="color:var(--fg-muted)">{goInstallCmd}</code>.
              Prebuilt binaries for macOS, Linux, and Windows · amd64/arm64 are on the{" "}
              <span style="white-space:nowrap"><a href="https://github.com/cwest/okfctl/releases" style="color:var(--fg-muted);border-bottom:1px solid var(--border-loud)" rel="noopener">releases</a> page.</span>
            </p>

            <div class="specstrip">
              <span>pure Go</span><span>runs offline</span>
            </div>
          </div>

          <!-- what init and one node new produce -->
          <div class="panel">
            <div class="panel-hd">
              <span>okfctl bundle init mykb</span>
              <span class="flag" style="color:var(--ok)">✓ conformant</span>
            </div>
            <div class="tree">
              <div><span class="dir">mykb/</span></div>
              <div><span class="g">├─</span> <span class="rsv">index.md</span><span class="tag">reserved · okf_version 0.3</span></div>
              <div><span class="g">├─</span> <span class="rsv">log.md</span><span class="tag">reserved</span></div>
              <div><span class="g">└─</span> <span class="dir">concepts/</span></div>
              <div><span class="g">&nbsp;&nbsp; ├─</span> <span class="rsv">index.md</span><span class="tag">generated</span></div>
              <div><span class="g">&nbsp;&nbsp; └─</span> tannin.md<span class="tag">Reference</span></div>
            </div>
            <div class="fm" aria-label="Frontmatter of concepts/tannin.md">
              <div class="d">--- <span style="opacity:.7">concepts/tannin.md</span></div>
              <div><span class="k">type</span>: <span class="v">Reference</span></div>
              <div><span class="k">title</span>: <span class="v">Tannin</span></div>
              <div><span class="k">created</span>: <span class="v">2026-11-27T10:36:24-05:00</span></div>
              <div><span class="k">modified</span>: <span class="v">2026-11-27T10:36:24-05:00</span></div>
              <div class="d">---</div>
            </div>
          </div>
        </div>
      </section>

      <!-- ══ provenance band ═════════════════════════════════════════════════ -->
      <div class="band">
        <div class="wrap band-in">
          <p class="eyebrow" style="flex:none">The spec</p>
          <p>
            <strong>okfctl follows the OKF spec. It doesn't write it.</strong>{" "}
            The format lives in{" "}
            <a href="https://github.com/open-knowledge-format/open-knowledge-format/blob/main/SPEC.md" rel="noopener">open-knowledge-format/open-knowledge-format</a>,
            and where the spec defines a behavior, okfctl does what it says. <code class="mono" style="color:var(--fg)">validate</code> fails
            only on what the spec calls nonconformant (OKF §11.1). Any <code class="mono" style="color:var(--fg)">type</code> it has never seen
            still passes, and so does a frontmatter key from a later version (§11.2). Your team's type templates get checked only when you pass{" "}
            <code class="mono" style="color:var(--fg)">--templates</code>.
          </p>
        </div>
      </div>

      <!-- ══ 01 · link graph ═════════════════════════════════════════════════ -->
      <section class="sec" id="graph">
        <div class="wrap">
          <div class="sec-hd">
            <div>
              <span class="numeral">01</span>
            </div>
            <div>
              <p class="lede">
                Press the button. Four notes link to <code class="mono" style="color:var(--fg)">tannin.md</code>, and{" "}
                <code class="mono" style="color:var(--fg)">okfctl node mv</code> moves it to <code class="mono" style="color:var(--fg)">reference/</code>{" "}
                and fixes all four links. Each one gets the relative path that's right from its own folder, and the move goes into{" "}
                <code class="mono" style="color:var(--fg)">log.md</code>.
              </p>
            </div>
          </div>

          <div class="graph-grid">
            <div class="panel graph-stage">
              <div class="panel-hd"><span>bundle graph</span><span class="flag" id="graph-state">4 inbound links → concepts/tannin.md</span></div>
              <svg viewBox="0 0 540 400" role="img" aria-labelledby="graph-title" id="gsvg">
                <title id="graph-title">Four nodes link to the tannin node; moving it to the reference directory rewrites all four inbound links.</title>
                <g class="zone">
                  <rect x="16" y="30" width="212" height="238" rx="8" />
                  <text x="28" y="50">concepts/</text>
                </g>
                <g class="zone">
                  <rect x="16" y="286" width="212" height="94" rx="8" />
                  <text x="28" y="306">method/</text>
                </g>
                <g class="zone zone--target" id="zone-ref" style="opacity:.35;transition:opacity .5s var(--ease)">
                  <rect x="316" y="120" width="208" height="130" rx="8" />
                  <text x="328" y="140">reference/</text>
                </g>

                <g id="edges">
                  <path class="edge" d=""></path>
                  <path class="edge" d=""></path>
                  <path class="edge" d=""></path>
                  <path class="edge" d=""></path>
                </g>

                <g class="nd"><rect x="44" y="70" width="140" height="32" /><text x="58" y="90">aging.md</text></g>
                <g class="nd"><rect x="44" y="124" width="140" height="32" /><text x="58" y="144">oak.md</text></g>
                <g class="nd"><rect x="44" y="178" width="140" height="32" /><text x="58" y="198">barrel-aging.md</text></g>
                <g class="nd"><rect x="44" y="328" width="140" height="32" /><text x="58" y="348">tasting-notes.md</text></g>
                <g class="nd nd--focus" id="node-tannin" style="transform:translate(0px,0px)">
                  <rect x="44" y="222" width="140" height="32" /><text x="58" y="242">tannin.md</text>
                </g>
              </svg>
              <div class="graph-ctl">
                <button class="btn btn-primary" id="mv-btn" type="button">Run <span class="mono" style="font-weight:500">node mv</span></button>
                <output class="graph-out" id="mv-out" hidden></output>
              </div>
            </div>

            <div class="panel">
              <div class="panel-hd"><span>inbound links rewritten</span><span class="flag mono" id="diff-state" style="color:var(--fg-faint)">before</span></div>
              <div class="diff" id="diff" aria-live="polite">
                <span class="file">concepts/aging.md</span>
                <div class="row ctx"><span class="s"> </span><span># Aging</span></div>
                <div class="row ctx"><span class="s"> </span><span> </span></div>
                <div class="row del" data-when="after"><span class="s">-</span><span>Oak barrels add [tannin](<span class="t">tannin.md</span>) over time.</span></div>
                <div class="row add" data-when="after" hidden><span class="s">+</span><span>Oak barrels add [tannin](<span class="t">../reference/tannin.md</span>) over time.</span></div>

                <span class="file">method/tasting-notes.md</span>
                <div class="row ctx"><span class="s"> </span><span># Tasting notes</span></div>
                <div class="row ctx"><span class="s"> </span><span> </span></div>
                <div class="row del" data-when="after"><span class="s">-</span><span>Rate grip via [tannin](<span class="t">../concepts/tannin.md</span>).</span></div>
                <div class="row add" data-when="after" hidden><span class="s">+</span><span>Rate grip via [tannin](<span class="t">../reference/tannin.md</span>).</span></div>

                <span class="file">log.md <span style="color:var(--fg-subtle)">· reserved</span></span>
                <div class="row ctx"><span class="s"> </span><span>## 2026-11-27</span></div>
                <div class="row add" id="log-after" hidden><span class="s">+</span><span>* moved concepts/tannin.md -&gt; reference/tannin.md</span></div>
                <div class="row ctx"><span class="s"> </span><span>* created concepts/tannin.md</span></div>
              </div>
              <div class="graph-ctl" style="justify-content:space-between">
                <p class="small" style="margin:0">Two of the four rewritten files are shown. One said <code class="mono">tannin.md</code> and the other said <code class="mono">../concepts/tannin.md</code>, and now both say <code class="mono">../reference/tannin.md</code>.</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ══ 02 · output ═════════════════════════════════════════════════════ -->
      <section class="sec" id="output" style="padding-top:0">
        <div class="wrap">
          <div class="sec-hd">
            <div>
              <span class="numeral">02</span>
              <h2 class="h-sec">What it actually prints.</h2>
            </div>
            <div>
              <p class="lede">
                The binary printed all of this. A test replays each tab against the current build and fails on the first line that drifts.
                The first four tabs build on one bundle.
              </p>
            </div>
          </div>

          <div class="term">
            <div class="term-tabs" role="tablist" aria-label="Example runs">
              <button class="term-tab" role="tab" aria-selected="true" aria-controls="t-cold" id="tab-cold" type="button">cold&nbsp;start</button>
              <button class="term-tab" role="tab" aria-selected="false" aria-controls="t-lint" id="tab-lint" type="button" tabindex="-1">lint&nbsp;--strict</button>
              <button class="term-tab" role="tab" aria-selected="false" aria-controls="t-eval" id="tab-eval" type="button" tabindex="-1">eval&nbsp;transparency</button>
              <button class="term-tab" role="tab" aria-selected="false" aria-controls="t-val" id="tab-val" type="button" tabindex="-1">validate&nbsp;·&nbsp;failing</button>
              <button class="term-tab" role="tab" aria-selected="false" aria-controls="t-scale" id="tab-scale" type="button" tabindex="-1">at&nbsp;scale</button>
            </div>

            <div class="term-body">
              <div role="tabpanel" id="t-cold" aria-labelledby="tab-cold" tabindex="0">
<pre data-transcript>
<span class="p">$</span> <span class="c">okfctl bundle init</span> <span class="f">mykb</span>
<span class="o">Initialized OKF bundle in mykb</span>
<span class="p">$</span> <span class="c">okfctl node new</span> <span class="f">concepts/tannin.md</span> <span class="f">--type</span> Reference <span class="f">--title</span> <span class="s">"Tannin"</span> <span class="f">--bundle</span> mykb
<span class="o">Created mykb/concepts/tannin.md</span>
<span class="p">$</span> <span class="c">okfctl node list</span> <span class="f">--bundle</span> mykb
<span class="o">concepts/tannin.md                       Reference</span>
<span class="p">$</span> <span class="c">okfctl index check</span> <span class="f">mykb</span>
<span class="o">OK: index.md is current</span>
<span class="p">$</span> <span class="c">okfctl validate</span> <span class="f">mykb</span>
<span class="ok">OK: bundle conforms to the OKF spec floor</span></pre>
                <p class="term-note">You never ran an index command: <code class="mono">node new</code> wrote both <code class="mono">index.md</code> files and the <code class="mono">log.md</code> entry for you.</p>
              </div>

              <div role="tabpanel" id="t-lint" aria-labelledby="tab-lint" tabindex="0" hidden>
              {/* transcript: exit 1 okfctl lint --strict mykb */}
<pre data-transcript>
<span class="p">$</span> <span class="c">okfctl node new</span> <span class="f">concepts/oak.md</span> <span class="f">--type</span> Reference <span class="f">--title</span> <span class="s">"Oak"</span> <span class="f">--bundle</span> mykb
<span class="o">Created mykb/concepts/oak.md</span>
<span class="p">$</span> <span class="c">echo</span> <span class="s">'Oak barrels add tannin to red wine.'</span> &gt;&gt; mykb/concepts/oak.md
<span class="p">$</span> <span class="c">okfctl lint</span> <span class="f">mykb</span>
<span class="o">missing-xref: concepts/oak.md mentions "Tannin" but does not link to concepts/tannin.md</span>
<span class="o">1 lint finding(s)</span>
<span class="p">$</span> <span class="c">okfctl lint</span> <span class="f">--strict</span> <span class="f">mykb</span>
<span class="o">missing-xref: concepts/oak.md mentions "Tannin" but does not link to concepts/tannin.md</span>
<span class="o">1 lint finding(s)</span>
<span class="bad">okfctl: 1 lint finding(s)</span></pre>
                <p class="term-note">The oak note says tannin but doesn't link to it. Plain <code class="mono">lint</code> prints the finding and exits 0, and <code class="mono">lint --strict</code> exits 1 on the same finding. Put the strict one in CI.</p>
              </div>

              <div role="tabpanel" id="t-eval" aria-labelledby="tab-eval" tabindex="0" hidden>
              {/* transcript: exit 1 okfctl eval transparency --strict mykb */}
<pre data-transcript>
<span class="p">$</span> <span class="c">okfctl eval transparency</span> <span class="f">--strict</span> <span class="f">mykb</span>
<span class="o">grade-missing: concepts/oak.md carries no epistemic or authority grade (provenance is invisible)</span>
<span class="o">uncited: concepts/oak.md carries no citations (no sources, no # Citations, no internal reference)</span>
<span class="o">grade-missing: concepts/tannin.md carries no epistemic or authority grade (provenance is invisible)</span>
<span class="o">uncited: concepts/tannin.md carries no citations (no sources, no # Citations, no internal reference)</span>
<span class="o">4 transparency finding(s)</span>
<span class="bad">okfctl: 4 transparency finding(s)</span></pre>
                <p class="term-note">The two notes pass the spec. Neither one cites a source or grades its confidence. Checking that a source really backs a claim takes a person. <code class="mono">okfctl eval sample</code> picks the nodes and writes that person a worksheet.</p>
              </div>

              <div role="tabpanel" id="t-val" aria-labelledby="tab-val" tabindex="0" hidden>
              {/* transcript: exit 1 okfctl validate mykb */}
<pre data-transcript>
<span class="p">$</span> <span class="c">sed</span> <span class="f">-i.bak</span> <span class="s">'s/^title: Tannin$/title: [Tannin/'</span> mykb/concepts/tannin.md
<span class="p">$</span> <span class="c">okfctl validate</span> <span class="f">mykb</span>
<span class="bad">FAIL concepts/tannin.md: unparseable frontmatter</span>
<span class="bad">okfctl: 1 conformance finding(s)</span></pre>
                <p class="term-note">One stray bracket and the frontmatter won't parse. Spec §11.1 says it has to, and <code class="mono">validate</code> exits 1.</p>
              </div>

              <div role="tabpanel" id="t-scale" aria-labelledby="tab-scale" tabindex="0" hidden>
              {/* transcript: setup
              $ cp -R "$TRANSCRIPT_FIXTURES/homepage/stackoverflow" stackoverflow
              */}
<pre data-transcript>
<span class="p">$</span> <span class="c">okfctl bundle info</span> <span class="f">stackoverflow</span>
<span class="o">nodes: 26</span>
<span class="o">reserved: 6</span>
<span class="o">okf_version: 0.3 (declared in index.md)</span>
<span class="p">$</span> <span class="c">okfctl validate</span> <span class="f">stackoverflow</span>
<span class="ok">OK: bundle conforms to the OKF spec floor</span>
<span class="p">$</span> <span class="c">okfctl analyze</span> <span class="f">stackoverflow</span> | <span class="c">head</span> <span class="f">-3</span>
<span class="o"># OKF Corpus Analysis</span>
<span class="o"></span>
<span class="o">26 node(s), 61 internal link(s). Aging threshold: 180d.</span>
<span class="p">$</span> <span class="c">okfctl lint</span> <span class="f">stackoverflow</span> | <span class="c">tail</span> <span class="f">-1</span>
<span class="o">22 lint finding(s)</span></pre>
                <p class="term-note">This is the <a href="https://github.com/open-knowledge-format/open-knowledge-format/tree/527e81aff55992be21507e97004286789126f88c/bundles/stackoverflow" rel="noopener">Stack Overflow sample bundle</a> from the OKF repository. Other people wrote it. It passes the spec, and <code class="mono">lint</code> still finds 22 things to fix: 21 places where a note names another node and doesn't link it, plus one tag spelled two ways.</p>
              </div>
