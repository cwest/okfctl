{
  "name": "okfctl-site",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prebuild": "node scripts/prepare-content.mjs && node scripts/generate-share-assets.mjs",
    "dev": "npm run prebuild && astro dev",
    "start": "npm run prebuild && astro dev",
    "build": "npm run prebuild && astro build",
    "preview": "astro preview",
    "test": "npm run build && node --test 'tests/**/*.test.mjs'",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.6",
    "@astrojs/starlight-tailwind": "5.0.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.8",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2"
  },
  "overrides": {
    "zod": "4.6.7",
    "undici": "8.12.3",
    "postcss-selector-parser": "6.1.5"
  }
}
